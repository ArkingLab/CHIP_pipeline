###################################################################################
# INSTALL #

mkdir $WORK_DIR  ; cd  $WORK_DIR 

wget ftp://ftp.ccb.jhu.edu//pub/dpuiu/Homo_sapiens_mito/CHIP/download.sh
. ./download.sh

###################################################################################
# RUN MUTECT2 # 

mkdir -p $OUT_DIR

#run chip_mutect2.sh on each BAM/CRAM alignment file
IN=$IN_DIR/CRAM_file ; OUT=$OUT_DIR/prefix ; ./chip_mutect2.sh $IN $OUT

###################################################################################
# MERGE VCF OUTPUT FILES # 

# add SM=sample label to each $OUT_DIR/*.filt.vcf.gz SNV
# merge $OUT_DIR/*.filt.vcf.gz files  =>  mutect2.filter.1.vcf

###################################################################################
# RUN CHIP ANALYSYS #

./Manual_START_UKB_Filter.sh

